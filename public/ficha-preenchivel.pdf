507 0 obj
<< /A << /JS (var doc = this;\nfunction F\(n\){ return doc.getField\(n\); }\nfunction gv\(n\){ var f = F\(n\); if \(!f\) return ""; var v = f.value; if \(v === null || v === undefined || v === "Off"\) return ""; return String\(v\); }\nfunction num\(n\){ var s = gv\(n\).replace\(",", "."\).replace\(/[^0-9.]/g, ""\); var x = parseFloat\(s\); return isNaN\(x\) ? 0 : x; }\nfunction sv\(n, v\){ var f = F\(n\); if \(f\) f.value = v; }\nfunction chk\(n\){ var v = gv\(n\); return v !== "" && v !== "Off"; }\nfunction fmt\(x, d\){ return x.toFixed\(d\).replace\(".", ","\); }\n\nvar peso = num\("peso"\), alt = num\("altura"\), idade = num\("idade"\), cint = num\("cintura"\);\nif \(alt > 0 && alt < 3\) alt = alt * 100;\nvar obj = gv\("objetivo"\), niv = gv\("nivel"\), dias = parseInt\(gv\("dias"\), 10\), tempo = parseInt\(gv\("tempo"\), 10\);\n\nvar falta = [];\nif \(!peso\) falta.push\("Peso"\);\nif \(!alt\) falta.push\("Altura"\);\nif \(!obj\) falta.push\("Objetivo"\);\nif \(!niv\) falta.push\("N\\u00edvel de experi\\u00eancia"\);\nif \(!dias\) falta.push\("Dias por semana"\);\n\nif \(falta.length\) {\n  app.alert\("Para gerar seu treino, preencha:\\n\\n\\u2022 " + falta.join\("\\n\\u2022 "\), 1\);\n} else {\n  // ---------- Avalia\\u00e7\\u00e3o ----------\n  var imc = peso / Math.pow\(alt / 100, 2\);\n  var cls = imc < 18.5 ? "Abaixo do peso" : imc < 25 ? "Peso adequado" : imc < 30 ? "Sobrepeso" : imc < 35 ? "Obesidade grau I" : imc < 40 ? "Obesidade grau II" : "Obesidade grau III";\n  sv\("imc", fmt\(imc, 1\)\); sv\("imc_class", cls\);\n  var rce = cint > 0 ? cint / alt : 0;\n  sv\("rce", rce ? fmt\(rce, 2\) + \(rce < 0.5 ? "  \(adequado\)" : "  \(aten\\u00e7\\u00e3o\)"\) : ""\);\n\n  var fJ = chk\("r_joelho"\), fL = chk\("r_lombar"\), fO = chk\("r_ombro"\);\n  var fI = chk\("r_impacto"\) || imc >= 30 || idade >= 60;\n\n  // ---------- Biblioteca de exerc\\u00edcios ----------\n  // n = padr\\u00e3o | j = alternativa joelho | l = alternativa lombar | o = alternativa ombro\n  function X\(n, j, l, o\){ return { n: n, j: j, l: l, o: o }; }\n  var AGACH = X\("Agachamento livre", "Leg press 45\\u00b0 \(amplitude controlada\)", "Agachamento no Smith", null\);\n  var LEGP  = X\("Leg press 45\\u00b0", "Leg press 45\\u00b0 \(amplitude controlada\)", null, null\);\n  var STIFF = X\("Stiff com halteres", null, "Mesa flexora", null\);\n  var TERRA = X\("Levantamento terra romeno", null, "Cadeira flexora", null\);\n  var AFUN  = X\("Afundo com halteres", "Eleva\\u00e7\\u00e3o p\\u00e9lvica na m\\u00e1quina", null, null\);\n  var BULG  = X\("Agachamento b\\u00falgaro", "Cadeira abdutora", null, null\);\n  var HACK  = X\("Agachamento hack", "Leg press 45\\u00b0 \(amplitude controlada\)", null, null\);\n  var EXT   = X\("Cadeira extensora", "Cadeira extensora \(carga leve, 0\\u201360\\u00b0\)", null, null\);\n  var FLEX  = X\("Mesa flexora", null, null, null\);\n  var CFLEX = X\("Cadeira flexora", null, null, null\);\n  var PELV  = X\("Eleva\\u00e7\\u00e3o p\\u00e9lvica", null, null, null\);\n  var ABDU  = X\("Cadeira abdutora", null, null, null\);\n  var PANT  = X\("Panturrilha em p\\u00e9", null, "Panturrilha sentado", null\);\n  var PANTS = X\("Panturrilha sentado", null, null, null\);\n  var SUPB  = X\("Supino reto com barra", null, null, "Supino reto com halteres \(pegada neutra\)"\);\n  var SUPH  = X\("Supino reto com halteres", null, null, "Supino m\\u00e1quina \(pegada neutra\)"\);\n  var SUPI  = X\("Supino inclinado com halteres", null, null, "Supino inclinado m\\u00e1quina"\);\n  var SUPIM = X\("Supino inclinado m\\u00e1quina", null, null, null\);\n  var CRUC  = X\("Crucifixo m\\u00e1quina \(voador\)", null, null, null\);\n  var CROSS = X\("Crossover na polia", null, null, "Crucifixo m\\u00e1quina \(amplitude curta\)"\);\n  var DESH  = X\("Desenvolvimento com halteres", null, "Desenvolvimento m\\u00e1quina", "Eleva\\u00e7\\u00e3o lateral \(carga leve\)"\);\n  var DESM  = X\("Desenvolvimento m\\u00e1quina", null, null, "Eleva\\u00e7\\u00e3o frontal com anilha \(carga leve\)"\);\n  var ELAT  = X\("Eleva\\u00e7\\u00e3o lateral", null, null, null\);\n  var FACE  = X\("Face pull na polia", null, null, null\);\n  var PUXF  = X\("Puxada frontal", null, null, "Puxada com pegada neutra"\);\n  var PUXN  = X\("Puxada com pegada neutra", null, null, null\);\n  var REMC  = X\("Remada curvada com barra", null, "Remada apoiada no banco", null\);\n  var REMB  = X\("Remada baixa", null, null, null\);\n  var REMU  = X\("Remada unilateral com halter", null, "Remada m\\u00e1quina", null\);\n  var PULLD = X\("Pulldown bra\\u00e7os estendidos", null, null, null\);\n  var ROSD  = X\("Rosca direta", null, null, null\);\n  var ROSM  = X\("Rosca martelo", null, null, null\);\n  var ROSS  = X\("Rosca Scott", null, null, null\);\n  var TRIP  = X\("Tr\\u00edceps na polia \(barra\)", null, null, null\);\n  var TRIC  = X\("Tr\\u00edceps corda", null, null, null\);\n  var TRIF  = X\("Tr\\u00edceps franc\\u00eas com halter", null, null, "Tr\\u00edceps corda unilateral"\);\n  var MERG  = X\("Mergulho no banco", null, null, "Tr\\u00edceps na polia \(barra\)"\);\n  var PRAN  = X\("Prancha", null, null, null\);\n  var PRANL = X\("Prancha lateral", null, null, null\);\n  var ABD   = X\("Abdominal crunch", null, "Prancha", null\);\n  var ABDI  = X\("Abdominal infra \(eleva\\u00e7\\u00e3o de pernas\)", null, "Dead bug", null\);\n\n  var EXTRA = [X\("Abdominal na m\\u00e1quina", null, "Prancha", null\), PRAN, PRANL, X\("Bird dog", null, null, null\), X\("Dead bug", null, null, null\)];\n  var T = {\n    FA: ["Full Body A", [AGACH, SUPH, PUXF, STIFF, DESH, ROSD, TRIP, PRAN]],\n    FB: ["Full Body B", [LEGP, REMB, SUPIM, FLEX, ELAT, PELV, ABD, PANT]],\n    FC: ["Full Body C", [AFUN, PUXN, CRUC, EXT, REMU, ABDU, ROSM, PRANL]],\n    U1: ["Superiores 1", [SUPB, REMC, DESH, PUXF, CRUC, ROSD, TRIC, ELAT]],\n    L1: ["Inferiores 1", [AGACH, STIFF, LEGP, FLEX, EXT, PELV, PANT, PRAN]],\n    U2: ["Superiores 2", [SUPI, PUXN, REMB, DESM, FACE, ROSM, TRIF, ABD]],\n    L2: ["Inferiores 2", [TERRA, BULG, HACK, CFLEX, ABDU, PELV, PANTS, ABDI]],\n    PU: ["Peito \\u00b7 Ombros \\u00b7 Tr\\u00edceps", [SUPB, SUPI, DESH, CRUC, ELAT, TRIC, TRIF, MERG]],\n    PL: ["Costas \\u00b7 B\\u00edceps \\u00b7 Abd\\u00f4men", [PUXF, REMC, REMB, PULLD, FACE, ROSD, ROSM, ABD]],\n    LG: ["Pernas completo", [AGACH, LEGP, STIFF, EXT, FLEX, PELV, PANT, PRAN]],\n    CT: ["Peito \\u00b7 Tr\\u00edceps", [SUPB, SUPI, CRUC, CROSS, TRIP, TRIF, TRIC, MERG]],\n    CB: ["Costas \\u00b7 B\\u00edceps", [PUXF, REMC, REMU, REMB, PULLD, ROSD, ROSM, ROSS]],\n    OA: ["Ombros \\u00b7 Abd\\u00f4men", [DESH, ELAT, FACE, DESM, PRAN, ABD, ABDI, PRANL]],\n    QD: ["Quadr\\u00edceps \\u00b7 Panturrilha", [AGACH, HACK, LEGP, BULG, EXT, ABDU, PANT, PANTS]],\n    OB: ["Ombros \\u00b7 Bra\\u00e7os", [DESH, ELAT, FACE, ROSD, TRIP, ROSM, TRIF, ABD]],\n    PG: ["Posteriores \\u00b7 Gl\\u00fateos", [TERRA, FLEX, PELV, CFLEX, BULG, ABDU, PANTS, ABDI]],\n    PE: ["Peito", [SUPB, SUPI, SUPH, CRUC, CROSS, MERG, PRAN, ABD]],\n    CO: ["Costas", [PUXF, REMC, REMB, REMU, PULLD, FACE, PRANL, ABDI]]\n  };\n\n  var plan, seq, divNome, nota = "";\n  var ini = niv === "Iniciante", adv = niv === "Avancado";\n  if \(dias <= 2\) { plan = ["FA", "FB"]; seq = "A \\u2013 B"; divNome = "Full Body \(AB\)"; }\n  else if \(dias === 3\) {\n    if \(ini\) { plan = ["FA", "FB", "FC"]; divNome = "Full Body \(ABC\)"; }\n    else { plan = ["PU", "PL", "LG"]; divNome = "ABC \\u2013 Empurrar / Puxar / Pernas"; }\n    seq = "A \\u2013 B \\u2013 C";\n  } else if \(dias === 4\) {\n    if \(adv\) { plan = ["CT", "CB", "LG", "OA"]; divNome = "ABCD"; }\n    else { plan = ["U1", "L1", "U2", "L2"]; divNome = "Superiores / Inferiores \(ABCD\)"; }\n    seq = "A \\u2013 B \\u2013 C \\u2013 D";\n  } else if \(dias === 5\) {\n    if \(ini\) { plan = ["U1", "L1", "U2", "L2"]; seq = "A \\u2013 B \\u2013 C \\u2013 D \\u2013 A"; divNome = "Superiores / Inferiores \(ABCD\)";\n      nota = "Para iniciantes, 3 a 4 treinos de muscula\\u00e7\\u00e3o por semana s\\u00e3o suficientes. No 5\\u00ba dia, se preferir, troque por cardio leve."; }\n    else { plan = ["PE", "CO", "QD", "OB", "PG"]; seq = "A \\u2013 B \\u2013 C \\u2013 D \\u2013 E"; divNome = "ABCDE"; }\n  } else {\n    if \(ini\) { plan = ["U1", "L1", "U2", "L2"]; seq = "A \\u2013 B \\u2013 C \\u2013 D \\u2013 A \\u2013 B"; divNome = "Superiores / Inferiores \(ABCD\)";\n      nota = "Para iniciantes, recomendamos no m\\u00e1ximo 4 treinos de muscula\\u00e7\\u00e3o por semana. Use os dias extras para cardio leve ou mobilidade."; }\n    else { plan = ["PU", "PL", "LG"]; seq = "A \\u2013 B \\u2013 C \\u2013 A \\u2013 B \\u2013 C"; divNome = "ABC 2x \(Empurrar / Puxar / Pernas\)"; }\n  }\n\n  // ---------- Par\\u00e2metros por objetivo ----------\n  var S, R, D, cardio, metodo, objNome;\n  var nEx = ini ? 5 : adv ? 7 : 6;\n  if \(tempo === 30\) nEx -= 2; else if \(tempo === 45\) nEx -= 1; else if \(tempo === 90\) nEx += 1;\n  if \(nEx < 4\) nEx = 4; if \(nEx > 8\) nEx = 8;\n\n  if \(obj === "Emagrecimento"\) { objNome = "Emagrecimento"; S = "3"; R = "12\\u201315"; D = "30\\u201345s";\n    cardio = fI ? "25\\u201335 min de bike, el\\u00edptico ou caminhada inclinada ap\\u00f3s o treino" : "25\\u201335 min moderado ap\\u00f3s o treino \(ou HIIT de 15 min, 2x/sem\)";\n    metodo = "Ritmo cont\\u00ednuo: descanso curto e bi-set nos 2 \\u00faltimos exerc\\u00edcios."; }\n  else if \(obj === "Hipertrofia"\) { objNome = "Hipertrofia"; S = ini ? "3" : "4"; R = adv ? "6\\u201312" : "8\\u201312"; D = "60\\u201390s";\n    cardio = "15\\u201320 min leve, 2 a 3x por semana";\n    metodo = "Progress\\u00e3o de carga: ao fazer o topo das repeti\\u00e7\\u00f5es em todas as s\\u00e9ries, aumente a carga."; }\n  else if \(obj === "Forca"\) { objNome = "For\\u00e7a"; S = ini ? "3" : adv ? "5" : "4"; R = "4\\u20136"; D = "2\\u20133 min";\n    cardio = "10 min leve no aquecimento";\n    metodo = "Os 2 primeiros exerc\\u00edcios s\\u00e3o os principais \(carga alta\); os demais s\\u00e3o acess\\u00f3rios."; }\n  else if \(obj === "Condicionamento"\) { objNome = "Condicionamento f\\u00edsico"; S = "3"; R = "15\\u201320"; D = "30s";\n    cardio = fI ? "20 min intervalado na bike \(1 min forte / 2 min leve\)" : "20 min intervalado \(1 min forte / 2 min leve\)";\n    metodo = "Fa\\u00e7a em circuito: um exerc\\u00edcio ap\\u00f3s o outro; descanse 1\\u20132 min ao fim de cada volta."; }\n  else { objNome = "Sa\\u00fade e qualidade de vida"; S = ini ? "2" : "3"; R = "12\\u201315"; D = "60s";\n    cardio = "30 min de caminhada ou bike, 3 a 5x por semana";\n    metodo = "Foque na t\\u00e9cnica e na regularidade: const\\u00e2ncia vale mais que intensidade."; }\n\n  var nivNome = ini ? "Iniciante" : adv ? "Avan\\u00e7ado" : "Intermedi\\u00e1rio";\n  sv\("out_nome", \(gv\("nome"\) || "Aluno\(a\)"\).toUpperCase\(\)\);\n  sv\("out_objetivo", objNome\);\n  sv\("out_nivel", nivNome\);\n  sv\("out_freq", dias + "x por semana" + \(tempo ? " \\u00b7 " + tempo + " min" : ""\)\);\n  sv\("out_divisao", divNome\);\n  sv\("out_seq", seq\);\n  sv\("out_series", S + " s\\u00e9ries"\);\n  sv\("out_reps", R + " repeti\\u00e7\\u00f5es"\);\n  sv\("out_desc", D\);\n  sv\("out_cardio", cardio\);\n  sv\("out_metodo", metodo + \(nota ? "  " + nota : ""\)\);\n\n  // ---------- Montar treinos ----------\n  var L = ["A", "B", "C", "D", "E"];\n  for \(var w = 0; w < 5; w++\) {\n    var key = plan[w];\n    var used = {};\n    sv\("t_" + L[w], key ? T[key][0] : "\\u2014 n\\u00e3o utilizado nesta divis\\u00e3o"\);\n    var lst = key ? T[key][1].concat\(EXTRA\) : [];\n    var pick = [];\n    for \(var k = 0; k < lst.length && pick.length < nEx; k++\) {\n      var e = lst[k], nm0 = e.n;\n      if \(fL && e.l\) nm0 = e.l;\n      if \(fJ && e.j\) nm0 = e.j;\n      if \(fO && e.o\) nm0 = e.o;\n      if \(!used[nm0]\) { used[nm0] = 1; pick.push\(nm0\); }\n    }\n    for \(var i = 0; i < 8; i++\) {\n      var id = L[w] + \(i + 1\);\n      var nm = "", s = "", r = "", d = "";\n      if \(key && i < pick.length\) {\n        nm = pick[i];\n        s = S; r = R; d = D;\n        if \(obj === "Forca" && i >= 2\) { r = "8\\u201310"; d = "90s"; s = "3"; }\n        if \(/Prancha|Dead bug|Bird dog/.test\(nm\)\) { r = "30\\u201345s"; d = obj === "Forca" ? "60s" : D; }\n        if \(obj === "Condicionamento"\) d = "\\u2014";\n      }\n      sv\("e" + id, nm\); sv\("s" + id, s\); sv\("r" + id, r\); sv\("d" + id, d\);\n    }\n  }\n\n  // ---------- H\\u00e1bitos e recomenda\\u00e7\\u00f5es ----------\n  var dicas = [];\n  var aguaMeta = peso * 0.035, agua = num\("agua"\);\n  sv\("out_agua", fmt\(aguaMeta, 1\) + " L/dia"\);\n  var pMin, pMax;\n  if \(obj === "Hipertrofia" || obj === "Forca"\) { pMin = 1.6; pMax = 2.2; }\n  else if \(obj === "Emagrecimento"\) { pMin = 1.6; pMax = 2.0; }\n  else { pMin = 1.2; pMax = 1.6; }\n  sv\("out_prot", Math.round\(peso * pMin\) + "\\u2013" + Math.round\(peso * pMax\) + " g/dia"\);\n  var sono = num\("sono"\);\n  sv\("out_sono", "7\\u20139 h/noite"\);\n  sv\("out_treinos", Math.min\(dias, ini ? 4 : 6\) + " treinos/sem"\);\n\n  if \(agua > 0 && agua < aguaMeta\) dicas.push\("Hidrata\\u00e7\\u00e3o: voc\\u00ea bebe cerca de " + fmt\(agua, 1\) + " L e sua meta \\u00e9 " + fmt\(aguaMeta, 1\) + " L. Deixe uma garrafa sempre por perto e beba um copo a cada refei\\u00e7\\u00e3o."\);\n  else if \(!agua\) dicas.push\("Hidrata\\u00e7\\u00e3o: sua meta di\\u00e1ria \\u00e9 de " + fmt\(aguaMeta, 1\) + " L de \\u00e1gua \(35 ml por kg\)."\);\n  var ref = gv\("refeicoes"\);\n  if \(ref === "1-2"\) dicas.push\("Refei\\u00e7\\u00f5es: com apenas 1\\u20132 refei\\u00e7\\u00f5es fica dif\\u00edcil bater a prote\\u00edna e manter energia para treinar. Tente organizar 3 a 4 refei\\u00e7\\u00f5es."\);\n  var pr = gv\("proteina"\);\n  if \(pr === "Raramente" || pr === "Algumas"\) dicas.push\("Prote\\u00edna: inclua uma fonte \(ovos, carnes, frango, peixe, latic\\u00ednios ou leguminosas\) em cada refei\\u00e7\\u00e3o. Refer\\u00eancia para seu objetivo: " + Math.round\(peso * pMin\) + "\\u2013" + Math.round\(peso * pMax\) + " g por dia."\);\n  var fr = gv\("frutas"\);\n  if \(fr === "Raramente" || fr === "Algumas"\) dicas.push\("Frutas e vegetais: inclua ao menos 2 frutas por dia e metade do prato com vegetais no almo\\u00e7o e jantar."\);\n  var up = gv\("ultra"\);\n  if \(up === "Diario"\) dicas.push\("Ultraprocessados: o consumo di\\u00e1rio atrapalha seu resultado. Comece trocando um item por dia \(ex.: biscoito por fruta, refrigerante por \\u00e1gua com g\\u00e1s ou suco natural\)."\);\n  else if \(up === "Semanal"\) dicas.push\("Ultraprocessados: mantenha o consumo ocasional e planeje lanches pr\\u00e1ticos \(frutas, iogurte, castanhas\) para os dias corridos."\);\n  var al = gv\("alcool"\);\n  if \(al === "Frequente"\) dicas.push\("\\u00c1lcool: o consumo frequente prejudica a recupera\\u00e7\\u00e3o muscular, o sono e o controle de peso. Tente reduzir para ocasi\\u00f5es pontuais."\);\n  if \(sono > 0 && sono < 7\) dicas.push\("Sono: voc\\u00ea dorme cerca de " + fmt\(sono, 0\) + " h. Busque 7 a 9 h: \\u00e9 no descanso que o m\\u00fasculo se recupera e o apetite se regula."\);\n  else if \(gv\("sono_q"\) === "Ruim"\) dicas.push\("Sono: mesmo dormindo horas suficientes, a qualidade conta. Evite telas e cafe\\u00edna \\u00e0 noite e mantenha hor\\u00e1rios regulares."\);\n  if \(gv\("estresse"\) === "Alto"\) dicas.push\("Estresse: n\\u00edvel alto aumenta o cansa\\u00e7o e a fome. Nos dias mais pesados, reduza uma s\\u00e9rie por exerc\\u00edcio em vez de faltar ao treino."\);\n\n  if \(obj === "Emagrecimento"\) dicas.push\("Para emagrecer: o resultado vem do d\\u00e9ficit cal\\u00f3rico moderado somado ao treino. Evite dietas restritivas e procure um\(a\) nutricionista para um plano individual."\);\n  if \(obj === "Hipertrofia"\) dicas.push\("Para ganhar massa: coma o suficiente \(leve super\\u00e1vit cal\\u00f3rico\), distribua a prote\\u00edna ao longo do dia e registre suas cargas para garantir progress\\u00e3o."\);\n  if \(obj === "Forca"\) dicas.push\("Para ganhar for\\u00e7a: aque\\u00e7a bem antes dos exerc\\u00edcios principais \(2\\u20133 s\\u00e9ries leves\) e priorize a t\\u00e9cnica perfeita antes de subir a carga."\);\n  if \(fI\) dicas.push\("Impacto: priorizamos exerc\\u00edcios e cardio de baixo impacto para proteger as articula\\u00e7\\u00f5es."\);\n  if \(fJ || fL || fO\) dicas.push\("Restri\\u00e7\\u00f5es informadas: alguns exerc\\u00edcios foram substitu\\u00eddos por vers\\u00f5es mais seguras. Se sentir dor, interrompa e procure orienta\\u00e7\\u00e3o."\);\n  if \(idade >= 60\) dicas.push\("Acima dos 60 anos: fa\\u00e7a uma avalia\\u00e7\\u00e3o m\\u00e9dica antes de iniciar e priorize m\\u00e1quinas e movimentos controlados."\);\n  if \(dicas.length < 3\) dicas.push\("Seus h\\u00e1bitos est\\u00e3o no caminho certo! Mantenha a regularidade e reavalie suas medidas a cada 4 semanas."\);\n\n  sv\("out_dicas", "\\u2022 " + dicas.join\("\\n\\n\\u2022 "\)\);\n  app.alert\("Pronto! Sua ficha de treino foi gerada nas pr\\u00f3ximas p\\u00e1ginas.", 3\);\n  try { doc.pageNum = 3; } catch \(err\) {}\n}\n) /S /JavaScript >> /AP << /N 894 0 R >> /F 4 /FT /Btn /Ff 65536 /H /P /MK << >> /P 511 0 R /Rect [ 319.275591 175.889764 489.275591 211.889764 ] /Subtype /Widget /T (btn_gerar) /TU (Gerar meu treino) /Type /Annot >>
endobj
